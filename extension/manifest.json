{
  "manifest_version": 3,
  "name": "自动组货采集器",
  "version": "3.1.0",
  "description": "统一采集 Temu 和 1688 商品、SKU、图片与店铺数据，分别保存到扩展 cache 和 Server cache。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://temu.com/*",
    "https://*.temu.com/*",
    "https://detail.1688.com/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icon.ico",
    "48": "icon.ico",
    "128": "icon.ico"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "自动组货采集器",
    "default_icon": {
      "16": "icon.ico",
      "32": "icon.ico",
      "48": "icon.ico"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://temu.com/*",
        "https://*.temu.com/*",
        "https://detail.1688.com/offer/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
